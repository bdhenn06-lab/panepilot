# PanePilot environment variables.
# Copy this file to `.env.local` and fill in the values. `.env.local` is
# git-ignored and never uploaded — Vercel injects these at build time.
#
# NEXT_PUBLIC_* values are exposed to the browser. Everything else is
# server-only and must never be prefixed with NEXT_PUBLIC_.

# ── Required ────────────────────────────────────────────────────────────────
# Supabase project URL and anon/publishable key (Supabase → Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Toggle the Stripe billing UI/checkout. Leave "false" unless billing is set up.
NEXT_PUBLIC_BILLING_ENABLED=false

# ── Optional: Stripe billing (only when NEXT_PUBLIC_BILLING_ENABLED=true) ─────
# The webhook uses the service-role key to sync orgs.plan; keep it server-side.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring price IDs for each plan (Solo $79 / Crew $199 / Franchise $499).
STRIPE_PRICE_SOLO=
STRIPE_PRICE_CREW=
STRIPE_PRICE_FRANCHISE=

# ── Optional: transactional email (invites, follow-up reminders) ─────────────
# When unset, these paths no-op and invites remain shareable links.
RESEND_API_KEY=
RESEND_FROM=PanePilot <onboarding@resend.dev>

# ── Optional: daily reminders cron (/api/reminders) ──────────────────────────
# Bearer token Vercel Cron sends to authorize the reminders job.
CRON_SECRET=
