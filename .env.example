# PanePilot environment. Copy to .env.local and fill in the required values:
#
#   cp .env.example .env.local
#
# Next.js reads .env.local at startup, so restart `npm run dev` after editing.
# Keep this file in the repo; never commit .env.local (it is gitignored).


# ---------------------------------------------------------------------------
# Required — Supabase (database + auth). Without these the app serves only a
# setup page. Supabase dashboard -> Project Settings -> API.
# ---------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable / anon key (the `sb_publishable_…` or `eyJ…` one). Safe to expose
# to the browser — row-level security is what protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# ---------------------------------------------------------------------------
# Optional — billing (Stripe). The plan buttons, checkout, customer portal and
# webhook sync are all built; this flag is what reveals them.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_BILLING_ENABLED=false

# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Recurring price IDs: Solo $79, Crew $199, Franchise $499 per month.
# STRIPE_PRICE_SOLO=price_...
# STRIPE_PRICE_CREW=price_...
# STRIPE_PRICE_FRANCHISE=price_...

# Service-role key — bypasses row-level security, server-only. Required by the
# Stripe webhook (to write orgs.plan) and the reminder cron. Never expose this.
# SUPABASE_SERVICE_ROLE_KEY=


# ---------------------------------------------------------------------------
# Optional — transactional email (Resend). Unset, invites stay shareable links
# and the follow-up digest no-ops.
# ---------------------------------------------------------------------------

# RESEND_API_KEY=re_...
# RESEND_FROM=PanePilot <hello@yourdomain.com>


# ---------------------------------------------------------------------------
# Optional — cron. Vercel sends this as a bearer token to /api/reminders (see
# vercel.json). When unset the endpoint is unauthenticated.
# ---------------------------------------------------------------------------

# CRON_SECRET=
