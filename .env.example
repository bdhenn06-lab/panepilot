# Copy to .env.local and fill in. Only the two Supabase values are required.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_BILLING_ENABLED=false

# Billing (only when NEXT_PUBLIC_BILLING_ENABLED=true) — see README "Activating Stripe billing"
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO=
STRIPE_PRICE_CREW=
STRIPE_PRICE_FRANCHISE=
SUPABASE_SERVICE_ROLE_KEY=

# Email (optional) — invites and follow-up reminders no-op without a key
RESEND_API_KEY=
RESEND_FROM=

# Shared secret Vercel Cron sends to /api/reminders
CRON_SECRET=
