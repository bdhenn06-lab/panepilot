# Copy to .env.local and fill in. Only the two Supabase values are required to run.
# Supabase → Project Settings → API. Keys are inlined into the client bundle
# (NEXT_PUBLIC_*), so restart `npm run dev` after changing them.

# --- Required ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# --- Optional: billing (see README "Activating Stripe billing") ---------------
NEXT_PUBLIC_BILLING_ENABLED=false
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_SOLO=price_...
# STRIPE_PRICE_CREW=price_...
# STRIPE_PRICE_FRANCHISE=price_...
# Service-role key: used only by the Stripe webhook and the reminders cron. Never expose to the browser.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Optional: email (see README "Email (Resend)") ---------------------------
# RESEND_API_KEY=re_...
# RESEND_FROM=PanePilot <hello@yourdomain.com>

# --- Optional: protects /api/reminders when hit by Vercel Cron ---------------
# CRON_SECRET=
